{
  "components": {
    "schemas": {
      "AssignmentListResponse": {
        "additionalProperties": false,
        "description": "Browser-safe assignment collection response.",
        "properties": {
          "assignments": {
            "items": {
              "$ref": "#/components/schemas/AssignmentSummary"
            },
            "title": "Assignments",
            "type": "array"
          }
        },
        "required": [
          "assignments"
        ],
        "title": "AssignmentListResponse",
        "type": "object"
      },
      "AssignmentSummary": {
        "additionalProperties": false,
        "description": "Browser-safe projection of one authoritative academic assignment.",
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "course_id",
          "title",
          "description",
          "due_at",
          "updated_at"
        ],
        "title": "AssignmentSummary",
        "type": "object"
      },
      "CourseListResponse": {
        "additionalProperties": false,
        "description": "Browser-safe course collection response.",
        "properties": {
          "courses": {
            "items": {
              "$ref": "#/components/schemas/CourseSummary"
            },
            "title": "Courses",
            "type": "array"
          }
        },
        "required": [
          "courses"
        ],
        "title": "CourseListResponse",
        "type": "object"
      },
      "CourseSummary": {
        "additionalProperties": false,
        "description": "Browser-safe projection of an active academic course.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "title",
          "code",
          "description",
          "updated_at"
        ],
        "title": "CourseSummary",
        "type": "object"
      },
      "DocumentExtractionStatusView": {
        "description": "Persisted document-extraction states safe for browser projection.",
        "enum": [
          "SUCCESS",
          "PARTIAL",
          "NO_TEXT"
        ],
        "title": "DocumentExtractionStatusView",
        "type": "string"
      },
      "DocumentIndexCoverageView": {
        "description": "Persisted index coverage states safe for browser projection.",
        "enum": [
          "FULL",
          "PARTIAL",
          "NONE"
        ],
        "title": "DocumentIndexCoverageView",
        "type": "string"
      },
      "DocumentIndexReadinessView": {
        "description": "Persisted per-document index states safe for browser projection.",
        "enum": [
          "PREPARING",
          "READY",
          "NOT_SEARCHABLE",
          "FAILED"
        ],
        "title": "DocumentIndexReadinessView",
        "type": "string"
      },
      "DocumentIngestionStatusView": {
        "description": "Persisted document-ingestion states safe for browser projection.",
        "enum": [
          "NEVER_ATTEMPTED",
          "READY",
          "FAILED"
        ],
        "title": "DocumentIngestionStatusView",
        "type": "string"
      },
      "DocumentListResponse": {
        "additionalProperties": false,
        "description": "Browser-safe document collection response.",
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            },
            "title": "Documents",
            "type": "array"
          }
        },
        "required": [
          "documents"
        ],
        "title": "DocumentListResponse",
        "type": "object"
      },
      "DocumentSummary": {
        "additionalProperties": false,
        "description": "Browser-safe projection of document readiness metadata.",
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "extraction_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentExtractionStatusView"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "index_coverage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentIndexCoverageView"
              },
              {
                "type": "null"
              }
            ]
          },
          "index_readiness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentIndexReadinessView"
              },
              {
                "type": "null"
              }
            ]
          },
          "ingestion_status": {
            "$ref": "#/components/schemas/DocumentIngestionStatusView"
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "course_id",
          "title",
          "ingestion_status",
          "extraction_status",
          "page_count",
          "index_readiness",
          "index_coverage",
          "updated_at"
        ],
        "title": "DocumentSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Stable response contract for process-level health checks.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "aaos",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
