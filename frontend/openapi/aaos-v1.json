{
  "components": {
    "schemas": {
      "AssignmentListResponse": {
        "additionalProperties": false,
        "description": "Browser-safe assignment collection response.",
        "properties": {
          "assignments": {
            "items": {
              "$ref": "#/components/schemas/AssignmentSummary"
            },
            "title": "Assignments",
            "type": "array"
          }
        },
        "required": [
          "assignments"
        ],
        "title": "AssignmentListResponse",
        "type": "object"
      },
      "AssignmentSummary": {
        "additionalProperties": false,
        "description": "Browser-safe projection of one authoritative academic assignment.",
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "course_id",
          "title",
          "description",
          "due_at",
          "updated_at"
        ],
        "title": "AssignmentSummary",
        "type": "object"
      },
      "CourseListResponse": {
        "additionalProperties": false,
        "description": "Browser-safe course collection response.",
        "properties": {
          "courses": {
            "items": {
              "$ref": "#/components/schemas/CourseSummary"
            },
            "title": "Courses",
            "type": "array"
          }
        },
        "required": [
          "courses"
        ],
        "title": "CourseListResponse",
        "type": "object"
      },
      "CourseSummary": {
        "additionalProperties": false,
        "description": "Browser-safe projection of an active academic course.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "title",
          "code",
          "description",
          "updated_at"
        ],
        "title": "CourseSummary",
        "type": "object"
      },
      "DocumentExtractionStatusView": {
        "description": "Persisted document-extraction states safe for browser projection.",
        "enum": [
          "SUCCESS",
          "PARTIAL",
          "NO_TEXT"
        ],
        "title": "DocumentExtractionStatusView",
        "type": "string"
      },
      "DocumentIndexCoverageView": {
        "description": "Persisted index coverage states safe for browser projection.",
        "enum": [
          "FULL",
          "PARTIAL",
          "NONE"
        ],
        "title": "DocumentIndexCoverageView",
        "type": "string"
      },
      "DocumentIndexReadinessView": {
        "description": "Persisted per-document index states safe for browser projection.",
        "enum": [
          "PREPARING",
          "READY",
          "NOT_SEARCHABLE",
          "FAILED"
        ],
        "title": "DocumentIndexReadinessView",
        "type": "string"
      },
      "DocumentIngestionStatusView": {
        "description": "Persisted document-ingestion states safe for browser projection.",
        "enum": [
          "NEVER_ATTEMPTED",
          "READY",
          "FAILED"
        ],
        "title": "DocumentIngestionStatusView",
        "type": "string"
      },
      "DocumentListResponse": {
        "additionalProperties": false,
        "description": "Browser-safe document collection response.",
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            },
            "title": "Documents",
            "type": "array"
          }
        },
        "required": [
          "documents"
        ],
        "title": "DocumentListResponse",
        "type": "object"
      },
      "DocumentSummary": {
        "additionalProperties": false,
        "description": "Browser-safe projection of document readiness metadata.",
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "extraction_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentExtractionStatusView"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "index_coverage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentIndexCoverageView"
              },
              {
                "type": "null"
              }
            ]
          },
          "index_readiness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentIndexReadinessView"
              },
              {
                "type": "null"
              }
            ]
          },
          "ingestion_status": {
            "$ref": "#/components/schemas/DocumentIngestionStatusView"
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "course_id",
          "title",
          "ingestion_status",
          "extraction_status",
          "page_count",
          "index_readiness",
          "index_coverage",
          "updated_at"
        ],
        "title": "DocumentSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Stable response contract for process-level health checks.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RagAnswerResponse": {
        "additionalProperties": false,
        "description": "Validated final answer projection safe for browser rendering.",
        "properties": {
          "answer_text": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Answer Text",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/RagCitation"
            },
            "title": "Citations",
            "type": "array"
          },
          "language": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Language",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RagAnswerStatus"
          }
        },
        "required": [
          "status",
          "answer_text",
          "language",
          "citations"
        ],
        "title": "RagAnswerResponse",
        "type": "object"
      },
      "RagAnswerStatus": {
        "enum": [
          "ANSWER",
          "PARTIAL_ANSWER",
          "INSUFFICIENT_EVIDENCE"
        ],
        "title": "RagAnswerStatus",
        "type": "string"
      },
      "RagCitation": {
        "additionalProperties": false,
        "description": "Safe public citation target resolved by trusted backend code.",
        "properties": {
          "document_id": {
            "exclusiveMinimum": 0.0,
            "title": "Document Id",
            "type": "integer"
          },
          "document_title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Document Title",
            "type": "string"
          },
          "page_end": {
            "exclusiveMinimum": 0.0,
            "title": "Page End",
            "type": "integer"
          },
          "page_start": {
            "exclusiveMinimum": 0.0,
            "title": "Page Start",
            "type": "integer"
          }
        },
        "required": [
          "document_id",
          "document_title",
          "page_start",
          "page_end"
        ],
        "title": "RagCitation",
        "type": "object"
      },
      "RagCourseScopeRequest": {
        "additionalProperties": false,
        "description": "Browser request selecting one trusted active-course scope.",
        "properties": {
          "course_id": {
            "exclusiveMinimum": 0.0,
            "title": "Course Id",
            "type": "integer"
          },
          "type": {
            "const": "course",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "course_id"
        ],
        "title": "RagCourseScopeRequest",
        "type": "object"
      },
      "RagGlobalScopeRequest": {
        "additionalProperties": false,
        "description": "Browser request selecting the trusted global academic scope.",
        "properties": {
          "type": {
            "const": "global",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "RagGlobalScopeRequest",
        "type": "object"
      },
      "RagQueryRequest": {
        "additionalProperties": false,
        "description": "Closed browser input for one read-only validated RAG query.",
        "properties": {
          "question": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "scope": {
            "discriminator": {
              "mapping": {
                "course": "#/components/schemas/RagCourseScopeRequest",
                "global": "#/components/schemas/RagGlobalScopeRequest"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/RagGlobalScopeRequest"
              },
              {
                "$ref": "#/components/schemas/RagCourseScopeRequest"
              }
            ],
            "title": "Scope"
          }
        },
        "required": [
          "question",
          "scope"
        ],
        "title": "RagQueryRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "aaos",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assignments": {
      "get": {
        "operationId": "list_assignments_api_v1_assignments_get",
        "parameters": [
          {
            "in": "query",
            "name": "course_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Course Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Assignments"
      }
    },
    "/api/v1/courses": {
      "get": {
        "operationId": "list_courses_api_v1_courses_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Courses"
      }
    },
    "/api/v1/courses/{course_id}": {
      "get": {
        "operationId": "get_course_api_v1_courses__course_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Course Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Course"
      }
    },
    "/api/v1/documents": {
      "get": {
        "operationId": "list_documents_api_v1_documents_get",
        "parameters": [
          {
            "in": "query",
            "name": "course_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Course Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Documents"
      }
    },
    "/api/v1/documents/{document_id}": {
      "get": {
        "operationId": "get_document_api_v1_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "title": "Document Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Document"
      }
    },
    "/api/v1/rag/queries": {
      "post": {
        "operationId": "ask_rag_api_v1_rag_queries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RagQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RagAnswerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask Rag"
      }
    },
    "/health": {
      "get": {
        "description": "Report that the AAOS API process is alive.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
