{
  "name": "aaos-frontend-contracts",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:openapi": "uv run python ../scripts/export_openapi.py",
    "generate:api-types": "npm run generate:openapi && openapi-typescript openapi/aaos-v1.json -o types/api.generated.ts",
    "check:api-types": "npm run generate:api-types && git diff --exit-code -- openapi/aaos-v1.json types/api.generated.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
